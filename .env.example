# Next server -> public DERBY CAREER API. Keep this variable server-only.
DERBY_API_URL=http://127.0.0.1:4000

# Optional server Career mode (local development only). Browser saves stay the default.
# NEXT_PUBLIC_CAREER_BACKEND=server
# Server-only dev-session token printed by the API CLI (AUTH_MODE=dev-session). Never expose it to the browser.
# DERBY_API_DEV_SESSION_TOKEN=
