DATABASE_URL=postgresql://derby:derby_local@127.0.0.1:5432/derby_career
HOST=127.0.0.1
PORT=4000
NODE_ENV=development
# disabled: public catalog only. dev-session: CLI-issued local sessions. oidc-jwt: trusted external JWT.
# dev-session is rejected in production and on non-loopback listen addresses.
AUTH_MODE=disabled
# Required only when AUTH_MODE=oidc-jwt. Copy the issuer and JWKS URL from the trusted provider.
# OIDC_ISSUER=https://identity.example.invalid
# OIDC_AUDIENCE=derby-career-api
# OIDC_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
# Access token type is at+jwt by default. Use JWT only for an API-specific provider session JWT.
# OIDC_TOKEN_TYPE=at+jwt
# Token age limit: 60..3600 seconds. Align provider token lifetime and client refresh with this limit.
# OIDC_MAX_TOKEN_AGE_SECONDS=3600
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Optional, valid JSON. Stored with each month's draw; changes affect new months only.
EVENT_DIRECTOR_CONFIG={"version":"event-director-v1","monthlyProbability":0.3,"pityAfterMisses":3,"monthStartShare":0.5}
