{
  "name": "@derby-career/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsup src/server.ts src/cli.ts --format esm --target node22 --out-dir dist --clean",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "lint": "node scripts/lint.mjs",
    "lint:fix": "node scripts/lint.mjs --fix",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:postgres": "node --env-file-if-exists=.env --import tsx --test tests/postgres.integration.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/cli.ts migrate",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/cli.ts seed",
    "events:convert": "node --import tsx scripts/convert-events.ts",
    "events:import": "node --env-file-if-exists=.env --import tsx src/cli.ts import-events",
    "session:create": "node --env-file-if-exists=.env --import tsx src/cli.ts session-create",
    "session:revoke": "node --env-file-if-exists=.env --import tsx src/cli.ts session-revoke",
    "contract:generate": "node --import tsx scripts/generate-api-types.ts && node --import tsx scripts/generate-event-validation.ts && node --import tsx scripts/generate-save-validation.ts",
    "contract:check": "node --import tsx scripts/check-contract.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "csv-parse": "^6.1.0",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pg": "^8.16.0",
    "yaml": "^2.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@electric-sql/pglite": "0.5.9",
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "10.12.0",
    "globals": "16.5.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tsup": "8.5.1",
    "tsx": "^4.20.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.71.2"
  }
}
